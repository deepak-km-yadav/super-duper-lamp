# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_CHAT_API_URL=/api/chat
# Optional. Used to build share/embed links; falls back to window.location.origin.
VITE_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase  (server-side only -- there is deliberately no VITE_SUPABASE_* var,
# because the browser must never hold a Supabase credential. All database
# access goes through the serverless functions in /api.)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Gates the BotForge dashboard APIs (bots, provider keys, action items).
# Long and random -- it protects real names, emails and phone numbers.
# No surrounding quotes and no trailing newline; on Vercel, a change here only
# takes effect after a redeploy.
BOTFORGE_ADMIN_TOKEN=
# Legacy token for the DesignInc leads dashboard (/leads, api/leads.ts) ONLY.
# It does not grant access to BotForge bots, keys or action items.
LEADS_DASHBOARD_TOKEN=

# ---------------------------------------------------------------------------
# Agent actions (Lead Magnet / Scheduler)
# ---------------------------------------------------------------------------
# Small, cheap model used for structured extraction of leads and meeting
# requests. Kept separate from the bot's own provider so extraction quality
# does not depend on which provider a given bot happens to use.
DETECTION_API_KEY=
DETECTION_MODEL=claude-haiku-4-5
# Salt for hashing visitor IPs (rate limiting without storing the IP itself).
VISITOR_IP_SALT=
# Shared secret for the hourly detection sweeper cron.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Capture notifications
# ---------------------------------------------------------------------------
# Email is sent through Resend (a single REST call, no SDK). The per-bot
# recipient is set in the bot's editor; these two make sending possible at all.
# A webhook needs neither -- set a URL on the bot and it posts JSON, which
# Zapier, Make, n8n and Slack incoming webhooks all accept.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Legacy DesignInc concierge (api/chat.ts)
# ---------------------------------------------------------------------------
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3
LEAD_CAPTURE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional providers
# ---------------------------------------------------------------------------
# Ollama runs on the user's machine, so a serverless function can only reach it
# via a publicly routable base URL. Leave unset to disable Ollama server-side.
OLLAMA_BASE_URL=
# Sent as HTTP-Referer on OpenRouter calls (was window.location.origin).
OPENROUTER_SITE_URL=
