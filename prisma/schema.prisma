generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  passwordHash   String?
  image          String?
  themePreference String      @default("dark")
  defaultModel   String       @default("V4_5ALL")
  defaultMood    String       @default("Romantic")
  defaultVocal   String       @default("Auto")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  generations    Generation[]
  favorites      Favorite[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Generation {
  id              String            @id @default(uuid())
  userId          String
  taskId          String?
  status          String            @default("queued")
  songType        String            @default("vocal")
  vocalGender     String?
  mode            String            @default("simple")
  genre           String?
  style           String?
  mood            String?
  tempo           String?
  title           String?
  prompt          String?
  lyrics          String?
  dedicationTo    String?
  dedicationFrom  String?
  relationship    String?
  dedicationMsg   String?
  model           String            @default("V4_5ALL")
  styleWeight     Float             @default(0.5)
  weirdness       Float             @default(0.5)
  audioWeight     Float             @default(0.5)
  negativeTags    String?
  personaId       String?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks GenerationTrack[]

  @@index([userId])
  @@index([status])
}

model GenerationTrack {
  id           String  @id @default(uuid())
  generationId String
  audioUrl     String?
  title        String?
  duration     Float?
  modelUsed    String?
  styleTags    String?
  imageUrl     String?
  createdAt    DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  favorites  Favorite[]

  @@index([generationId])
}

model Favorite {
  id      String @id @default(uuid())
  userId  String
  trackId String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track GenerationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}
